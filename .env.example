# BCP Build Lab — environment variables
#
# Copy this file to .env.local and fill in your OWN development values.
# Do NOT use production credentials for local development.
#   cp .env.example .env.local

# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Create your own free dev database at https://neon.tech (one project is enough).
# Neon gives you two connection strings on the project dashboard:
#   - The POOLED string (host contains "-pooler") -> DATABASE_URL (used at runtime)
#   - The DIRECT string (host WITHOUT "-pooler")   -> DIRECT_DATABASE_URL (used for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth (Auth.js / NextAuth v5) ────────────────────────────────────────────
# Generate a fresh secret for your dev environment:
#   openssl rand -base64 32
AUTH_SECRET="paste-a-freshly-generated-secret-here"

# ── Seed data ───────────────────────────────────────────────────────────────
# Password applied to the seed users created by `npm run db:seed`. Pick anything
# for local dev.
SEED_PASSWORD="choose-a-local-dev-password"

# ── AI scoring (Anthropic) ──────────────────────────────────────────────────
# Used by the "Draft with AI" triage feature. Get your own key at
# https://console.anthropic.com. Optional locally — the app runs without it;
# only the AI-draft button needs it.
ANTHROPIC_API_KEY="sk-ant-your-own-key"

# ── Vercel (auto-managed) ───────────────────────────────────────────────────
# VERCEL_OIDC_TOKEN is written automatically by `vercel link` / `vercel env pull`.
# You do not set this by hand.
